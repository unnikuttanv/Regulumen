# ReguLumen environment-variable configuration template.
# Copy this file to .env and fill in real values.
# All variables use the REGULUMEN_ prefix.
# .env is .gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# API keys (leave blank if not using the provider)
# ---------------------------------------------------------------------------

# Groq API key — required when llm_model starts with "groq/"
REGULUMEN_GROQ_API_KEY=

# Hugging Face token — needed for gated embedding models
REGULUMEN_HF_API_TOKEN=

# ---------------------------------------------------------------------------
# Model / provider selection
# ---------------------------------------------------------------------------

# LiteLLM model string for the chat/completion model
REGULUMEN_LLM_MODEL=groq/llama-3.3-70b-versatile

# Embedding provider ("huggingface" or "openai")
REGULUMEN_EMBEDDING_PROVIDER=huggingface

# Embedding model name (Hugging Face repo ID or OpenAI model name)
REGULUMEN_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Local path for the ChromaDB persistent store
REGULUMEN_CHROMA_PATH=./.chroma

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------

# Number of documents returned from the retriever
REGULUMEN_TOP_K=8

# Hybrid search blend: 0.0 = BM25 only, 1.0 = dense-vector only.
# Tuned default in code is 0.3 (best MRR at no recall cost); see
# docs/eval-tuning-notes.md.
REGULUMEN_HYBRID_ALPHA=0.5

# Drop sources whose parse structure_confidence is below this (degenerate PDFs).
# 0.0 disables filtering. Default 0.15 excludes the FDA Premarket transcript.
REGULUMEN_MIN_STRUCTURE_CONFIDENCE=0.15

# Q&A orchestrator: "graph" (LangGraph refine loop) or "linear" (single pass).
REGULUMEN_ANSWERER_MODE=graph

# Total generate cycles in the graph answerer; 2 = one refine retry.
REGULUMEN_MAX_ANSWER_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Abstention
# ---------------------------------------------------------------------------

# Minimum relevance score required to generate an answer (0.0–1.0).
# Below this threshold the assistant says "I cannot answer from the corpus."
REGULUMEN_ABSTENTION_THRESHOLD=0.7
